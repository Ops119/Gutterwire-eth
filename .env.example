# Copy to .env (gitignored) and fill in. Never commit real values.
TELEGRAM_BOT_TOKEN=
# Message the bot once, then run `python -m gutterwire chats` to find this id.
TELEGRAM_CHAT_ID=

# Optional: Gemini free tier for digest notes. Without it, template notes are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_BUDGET=20

# Optional: CoinMarketCap Basic key, backup source of reported market cap.
CMC_API_KEY=

# Rules
MAX_MARKET_CAP_USD=15000
MIN_LIQUIDITY_USD=0
MAX_BUY_TAX=0.10
MAX_SELL_TAX=0.10
DIGEST_INTERVAL_HOURS=48
GUTTERWIRE_DB=gutterwire.db
